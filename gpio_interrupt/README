Commands:
Compile DTS file
dtc -@ -I dts -O dtb \
-o gpio-test.dtbo \
gpio-test-overlay.dts

copy in boot folder
sudo cp gpio-test.dtbo /boot/firmware/overlays/

sudo reboot

grep gpio-test /boot/firmware/config.txt

ls -l /boot/firmware/overlays/gpio-test.dtbo

// manually load overlay
sudo dtoverlay gpio-test

// test if overlay exists
sudo dtoverlay -l

// to check gpio working
gpiomon -c gpiochip0 -b pull-up 17

insmod main.ko

cat /sys/devices/platform/gpio_test/value

cat /sys/devices/platform/gpio_test/irq_count

cat /sys/devices/platform/gpio_test/last_press_time

cat /dev/gpio_interrupt_device

